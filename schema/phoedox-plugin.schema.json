{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phoedox.com/schema/phoedox-plugin.json",
  "title": "Phoedox plugin manifest",
  "type": "object",
  "required": ["id", "name", "version", "hostApi", "engines"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$", "description": "Reverse-DNS id, e.g. de.example.ups" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "hostApi": { "type": "string", "pattern": "^\\d+$" },
    "engines": {
      "type": "object",
      "required": ["phoedox"],
      "properties": { "phoedox": { "type": "string", "description": "SemVer range, e.g. >=1.4.0 <2.0.0" } }
    },
    "backend": {
      "type": "object",
      "properties": { "wasm": { "type": "string" }, "memoryMb": { "type": "integer", "minimum": 1, "maximum": 256 } }
    },
    "frontend": { "type": "object", "properties": { "module": { "type": "string" } } },
    "criticalPath": { "type": "boolean", "description": "Plugin provides login or permission flows; never auto-disabled on recall, only isolated." },
    "contributes": {
      "type": "object",
      "properties": {
        "kinds": { "type": "array", "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "schema": { "type": "string" }, "icon": { "type": "string" } } } },
        "relations": { "type": "array", "items": { "type": "object", "required": ["id", "from", "to"], "properties": { "id": { "type": "string" }, "from": { "type": "array", "items": { "type": "string" } }, "to": { "type": "array", "items": { "type": "string" } }, "card": { "type": "string" } } } },
        "doctypes": { "type": "array", "items": { "type": "object", "required": ["id", "label"] } },
        "blocks": { "type": "array", "items": { "type": "object", "required": ["id", "label", "element"] } },
        "mcpTools": { "type": "array", "items": { "type": "object", "required": ["name"] } },
        "events": { "type": "array", "items": { "type": "string" } }
      }
    },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "license": {
      "type": "object",
      "properties": {
        "noncommercial": { "enum": ["free", "paid"] },
        "commercial": {
          "oneOf": [
            { "enum": ["free"] },
            { "type": "object", "required": ["plan"], "properties": { "plan": { "type": "string" }, "trialDays": { "type": "integer", "minimum": 0 } } }
          ]
        }
      }
    }
  }
}
