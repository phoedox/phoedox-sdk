{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phoedox.com/schema/phoedox-plugin.json",
  "title": "Phoedox store item manifest (plugin, theme or app template)",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "engines"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "plugin",
        "theme",
        "app"
      ],
      "default": "plugin",
      "description": "plugin (default) extends Phoedox; theme carries theme.json and an optional theme.css; app is an app template with app.json and files/…. Themes and app templates have no backend, frontend or permissions."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "description": "Reverse-DNS id, e.g. de.example.ups"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "hostApi": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "engines": {
      "type": "object",
      "required": [
        "phoedox"
      ],
      "properties": {
        "phoedox": {
          "type": "string",
          "description": "SemVer range, e.g. >=1.4.0 <2.0.0",
          "pattern": "^((>=|<=|>|<|=)?\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?\\s*)+$"
        }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "wasm": {
          "type": "string"
        },
        "memoryMb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "pattern": "\\.js$"
        }
      }
    },
    "criticalPath": {
      "type": "boolean",
      "description": "Plugin provides login or permission flows; never auto-disabled on recall, only isolated."
    },
    "contributes": {
      "type": "object",
      "properties": {
        "kinds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,39}$"
              },
              "schema": {
                "type": "string",
                "description": "JSON Schema file; top-level properties become attributes (x-unit for units)."
              },
              "icon": {
                "type": "string",
                "description": "Lucide icon name, e.g. battery-charging"
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "from",
              "to"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "from": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "card": {
                "type": "string"
              }
            }
          }
        },
        "doctypes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ]
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]{1,29}$"
              },
              "label": {
                "type": "string",
                "maxLength": 60
              },
              "icon": {
                "type": "string",
                "description": "Lucide icon name"
              },
              "element": {
                "type": "string",
                "pattern": "^phx-[a-z0-9]+(-[a-z0-9]+)*$",
                "description": "Frontend element that shows the block interactively (gets source, svg, project, doc and stateKey)."
              },
              "board": {
                "type": "boolean",
                "description": "May be placed on whiteboards."
              },
              "live": {
                "type": "boolean",
                "description": "On whiteboards the element runs interactively (e.g. a poll), not only the picture. Needs board and element."
              },
              "size": {
                "type": "object",
                "required": [
                  "w",
                  "h"
                ],
                "additionalProperties": false,
                "properties": {
                  "w": {
                    "type": "integer",
                    "minimum": 80,
                    "maximum": 2000
                  },
                  "h": {
                    "type": "integer",
                    "minimum": 80,
                    "maximum": 2000
                  }
                },
                "description": "Size on a whiteboard."
              },
              "example": {
                "type": "string",
                "maxLength": 4096,
                "description": "A source to start from."
              }
            }
          },
          "description": "Content blocks for pages (ADR-0086): a fenced block whose info string is the id. The backend export block_render draws it as SVG (shown everywhere); an optional frontend element makes it interactive."
        },
        "mcpTools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
              },
              "description": {
                "type": "string"
              },
              "input": {
                "type": "string",
                "description": "JSON Schema file of the arguments (type object)."
              },
              "control": {
                "type": "boolean",
                "description": "The tool acts on the physical world (switching, restarting). Only editors may run it; AI clients never run it directly, their calls become suggestions a person confirms."
              },
              "timeoutSec": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60,
                "description": "Time limit of one call in seconds (default 10)."
              },
              "target": {
                "type": "object",
                "description": "Which entry a control tool acts on, so owners can share single devices and allow AI control per device. arg names the argument; without attr its value is the slug of an entry of a kind this plugin contributes, with attr it is matched against that attribute of the entries (e.g. ha_entity).",
                "required": [
                  "arg"
                ],
                "additionalProperties": false,
                "properties": {
                  "arg": {
                    "type": "string",
                    "pattern": "^[a-z_][a-z0-9_]*$"
                  },
                  "attr": {
                    "type": "string",
                    "pattern": "^[a-z_][a-z0-9_]*$"
                  }
                }
              }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*|[a-z_]+\\.(\\*|[a-z_]+))$|^schedule:every=\\d+(s|m|h)$",
            "description": "schedule:every=60s (at least 30 s) or an event type like entity.saved, entity.*"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "description": "What the plugin may do. net:fetch:<host> allows one fixed host; net:fetch:config allows the hosts of the addresses the project owner sets for the plugin (secrets named url or *_url).",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "noncommercial": {
          "enum": [
            "free",
            "paid"
          ]
        },
        "commercial": {
          "oneOf": [
            {
              "enum": [
                "free"
              ]
            },
            {
              "type": "object",
              "required": [
                "plan"
              ],
              "properties": {
                "plan": {
                  "type": "string"
                },
                "trialDays": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "paid": {
          "type": "object",
          "required": [
            "plan"
          ],
          "properties": {
            "plan": {
              "type": "string"
            },
            "trialDays": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "The plugin only runs with a license (or within the trial)."
        }
      }
    },
    "description": {
      "type": "string",
      "description": "One or two sentences shown to admins and in the store."
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 40,
      "description": "Lucide icon name (kebab-case, e.g. battery-charging). With category it makes the plugin's tile in the store and the instance."
    },
    "category": {
      "type": "string",
      "enum": [
        "home",
        "network",
        "servers",
        "cloud",
        "monitoring",
        "development",
        "records",
        "blocks",
        "other"
      ],
      "description": "Store section and tile colour: home (smart home), network, servers (servers & storage), cloud (cloud & identity), monitoring, development, records (records & compliance), blocks (page blocks), other (default)."
    },
    "logo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*\\.svg$",
      "description": "SVG file at the package root (e.g. logo.svg, at most 64 KB, static: no scripts, no external references), shown instead of the tile. Only the product's own logo where its brand guidelines allow it (ADR-0090); the author confirms the right to use it."
    },
    "logoDark": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*\\.svg$",
      "description": "Variant of logo for dark backgrounds; without it the logo gets a light plate in dark mode."
    },
    "screenshots": {
      "type": "array",
      "maxItems": 6,
      "description": "Images of the plugin in use, stored in the package under screenshots/ (PNG, JPEG or WebP, at most 2 MB each).",
      "items": {
        "type": "object",
        "required": [
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^screenshots/[A-Za-z0-9._-]+\\.(png|jpe?g|webp)$"
          },
          "caption": {
            "type": "string",
            "maxLength": 140
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "plugin"
          }
        }
      },
      "then": {
        "required": [
          "hostApi"
        ]
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "type": {
              "const": "plugin"
            }
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "backend": false,
          "frontend": false,
          "permissions": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
